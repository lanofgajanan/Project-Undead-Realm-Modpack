{
  "level_limit": 18,
  "experience_per_level": {
    "type": "expression",
    "data": {
      "expression": "min(level ^ 1.3 * 30 + 20, 800)"
    }
  },
  "sources": [
    {
      "type": "puffish_skills:kill_entity",
      "data": {
        "variables": {
          "dropped_xp": {
            "operations": [
              {
                "type": "get_dropped_experience"
              }
            ]
          }
        },
        "experience": "dropped_xp * 2",
        "anti_farming": {
          "limit_per_chunk": 25,
          "reset_after_seconds": 300
        }
      }
    }
  ]
}
